<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/_Game/UI/USS/VictoryScreen.uss?fileID=7433441132597879392&amp;guid=ec93cb9d63cf5204da974c179d12c2aa&amp;type=3#VictoryScreen"/>
    <Style src="project://database/Assets/_Game/UI/USS/MainMenu.uss?fileID=7433441132597879392&amp;guid=efab7cc7c96ada7479d5ce489911a045&amp;type=3#MainMenu"/>
    <ui:VisualElement name="victory-container" style="flex-grow: 1; width: 100%; height: 100%; justify-content: center; align-items: center; background-color: rgb(23, 25, 35); opacity: 1;">
        <ui:Label text="HAS ESCAPADO" name="victory-title" style="font-size: 48px; color: rgb(229, 212, 181); -unity-font-definition: url(&quot;project://database/Assets/_Game/Art/Fonts/Sketch.ttf?fileID=12800000&amp;guid=2c57114ee5b8f3d44a9f3674ad34a97b&amp;type=3#Sketch&quot;); -unity-font-style: bold; -unity-text-align: middle-center; margin-bottom: 25px;"/>
        <ui:Label text="El ciclo se ha roto... pero sus ecos permanecerán." name="victory-message" style="margin-bottom: 35px; color: rgb(184, 169, 149); font-size: 20px; -unity-text-align: middle-center; max-width: 500px; -unity-font-definition: url(&quot;project://database/Assets/_Game/Art/Fonts/Sketch.ttf?fileID=12800000&amp;guid=2c57114ee5b8f3d44a9f3674ad34a97b&amp;type=3#Sketch&quot;);"/>
        <ui:Button text="Volver a jugar" name="restart-button" class="menu-button" style="background-color: rgba(81, 67, 55, 0); margin-bottom: 14px; border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px;"/>
        <ui:Button text="Menu principal" name="main-menu-button" class="menu-button"/>
    </ui:VisualElement>
</ui:UXML>
